# =============================================================================
#  行尾统一为 LF
# =============================================================================
# 源码含中文注释，Windows 上曾把整个仓库转成 CRLF，导致 git diff 出现
# "整文件改动"（内容其实没变）。这里统一为 LF，Windows 检出也保持 LF。
* text=auto eol=lf

# 二进制/素材，不做任何转换
*.png  binary
*.jpg  binary
*.h264 binary
*.h265 binary
*.aac  binary
*.ts   binary
